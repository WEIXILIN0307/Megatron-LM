[
  "docker",
  "exec",
  "--workdir",
  "<LOCAL_RUN_ROOT>/gdn",
  "--env",
  "CUDA_VISIBLE_DEVICES=<GPU_UUID>",
  "--env",
  "PYTHONPATH=<LOCAL_RUN_ROOT>/gdn:<LOCAL_RUN_ROOT>/runtime:/existing-artifacts/causal-conv1d-python:/existing-artifacts/flash-attn-python",
  "--env",
  "PYTEST_DISABLE_PLUGIN_AUTOLOAD=1",
  "--env",
  "PYTHONDONTWRITEBYTECODE=1",
  "--env",
  "NVTE_CPU_OFFLOAD_V1=1",
  "--env",
  "NVTE_ALLOW_NONDETERMINISTIC_ALGO=0",
  "--env",
  "OMP_NUM_THREADS=1",
  "--env",
  "TRITON_CACHE_DIR=<LOCAL_RUN_ROOT>/cache/triton",
  "--env",
  "TORCHINDUCTOR_CACHE_DIR=<LOCAL_RUN_ROOT>/cache/inductor",
  "gdn-review-pinned-20261125",
  "timeout",
  "900",
  "<LOCAL_HOME>/.venvs/megatron-gdn-offload/bin/python",
  "-m",
  "torch.distributed.run",
  "--standalone",
  "--nproc-per-node=1",
  "--log-dir",
  "<LOCAL_RUN_ROOT>/results/review-fixed-gdn-a6000-single/ranks",
  "--redirects",
  "3",
  "<LOCAL_RUN_ROOT>/runtime/rank_distributed_pytest.py",
  "<LOCAL_RUN_ROOT>/results/review-fixed-gdn-a6000-single/reports",
  "-vv",
  "-s",
  "-p",
  "no:cacheprovider",
  "tests/unit_tests/ssm/test_gated_delta_net_offloading.py",
  "tests/unit_tests/ssm/test_gdn_offload_training.py"
]
