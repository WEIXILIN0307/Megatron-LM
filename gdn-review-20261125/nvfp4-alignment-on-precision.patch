+    from transformer_engine.common.recipe import NVFP4BlockScaling  # type: ignore[import-untyped]
+    from transformer_engine.pytorch.fp8 import (  # type: ignore[import-untyped]
+        check_fp8_support,
+        check_nvfp4_support,
+    )
+
